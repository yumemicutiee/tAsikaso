# Copy this file to .env (never commit .env). On a host such as Render, set
# these as environment variables instead.

# Your key from https://platform.claude.com/ → API keys.
ANTHROPIC_API_KEY=sk-ant-...

# Any long random string, e.g. from
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The app sends it as "Authorization: Bearer <token>", so strangers who find
# the server's address can't run up your bill. Put the same value in the app
# (Settings → Smart Study, or --dart-define=STUDY_AI_TOKEN=...).
APP_TOKEN=change-me

# Hosts set this themselves.
PORT=8787

# Defaults shown. Effort: low, medium, high, xhigh or max.
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=high
# CLAUDE_CHECK_EFFORT=low

# --- Limits that protect the bill (all kept in memory; see README) ---

# Requests allowed per device (IP address) every 10 minutes.
# RATE_LIMIT=30

# Study kits + quizzes per device per day. 0 = no daily limit.
# DAILY_LIMIT=60

# Answer checks per device per day. 0 = no daily limit.
# DAILY_CHECK_LIMIT=300

# Estimated Claude spend per day for the whole server, in US dollars. Once
# it's reached, requests are refused until midnight. 0 = no cap.
# DAILY_BUDGET_USD=5

# Whose midnight starts a new day for the limits above.
# DAY_TIME_ZONE=Asia/Manila

# Number of proxies in front of the server (Render, Railway, nginx): 1 on
# those hosts, so the limits see each device's real address. Leave unset
# when the app connects to the server directly.
# TRUST_PROXY=1

# 1 = /health also shows the model and effort. Off by default.
# HEALTH_DETAILS=1
