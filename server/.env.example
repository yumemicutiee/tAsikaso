# Copy this file to .env (never commit .env).

# Your key from https://platform.claude.com/ → API keys.
ANTHROPIC_API_KEY=sk-ant-...

# Any long random string. The app sends it as "Authorization: Bearer <token>",
# so strangers who find the server's address can't run up your bill. Put the
# same value in the app (Settings → Smart Study, or --dart-define=STUDY_AI_TOKEN=...).
APP_TOKEN=change-me

PORT=8787

# Defaults shown. Effort: low, medium, high, xhigh or max.
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=high
# CLAUDE_CHECK_EFFORT=low

# Requests allowed per device every 10 minutes.
# RATE_LIMIT=30

# Set to 1 when the server runs behind a proxy (Render, Railway, nginx), so
# the rate limit sees the real client address.
# TRUST_PROXY=1
